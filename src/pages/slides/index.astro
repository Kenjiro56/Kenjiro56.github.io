---
import Layout from '../../layouts/Layout.astro';
import SlideCard from '../../components/SlideCard.astro';
import { getSlides } from '../../lib/slides';

const slides = await getSlides();
---

<Layout
  title="Slides | Kenjiro Hirose"
  description="Speaker Deck や Docswell などでの過去の登壇資料・発表スライド一覧"
>
  <div class="space-y-8">
    <div class="space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-semibold">
        <span>🎤 Presentations & Slides</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
        登壇スライド
      </h1>
      <p class="text-slate-400 text-base max-w-2xl">
        カンファレンスや勉強会で発表した Speaker Deck や Docswell などの資料一覧です。インタラクティブに埋め込み参照できます。
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {slides.map((slide) => (
        <SlideCard slide={slide} />
      ))}
    </div>
  </div>
</Layout>
