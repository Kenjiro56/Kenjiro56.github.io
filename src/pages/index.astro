---
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import PhotoCard from '../components/PhotoCard.astro';
import SlideCard from '../components/SlideCard.astro';
import { fetchAllArticles } from '../lib/rss';
import { getPhotos } from '../utils/photos';
import { getSlides } from '../lib/slides';

// 1. 最新のRSS記事の取得 (上位4件ピックアップ)
const allArticles = await fetchAllArticles();
const latestArticles = allArticles.slice(0, 4);

// 2. 最新写真の取得
const allPhotos = await getPhotos();
const latestPhotos = allPhotos.slice(0, 3);

// 3. 最新スライド
const allSlides = await getSlides();
const latestSlides = allSlides.slice(0, 2);

const snsLinks = [
  { name: 'GitHub', url: 'https://github.com/Kenjiro56', icon: '🐙', color: 'hover:border-purple-500/50 hover:bg-purple-950/20' },
  { name: 'X (Twitter)', url: 'https://x.com/r0se6k', icon: '𝕏', color: 'hover:border-cyan-500/50 hover:bg-cyan-950/20' },
  { name: 'LinkedIn', url: 'https://linkedin.com/in/kenjiro-hirose-2754bb2b4/', icon: '💼', color: 'hover:border-sky-500/50 hover:bg-sky-950/20' },
];
---

<Layout title="Kenjiro Hirose | Portfolio & Activity Log">
  <div class="space-y-16">
    <!-- Hero Profile Section -->
    <section class="relative bg-slate-900/60 rounded-3xl p-8 sm:p-12 border border-slate-800 backdrop-blur-xl shadow-2xl overflow-hidden">
      <!-- Glow background -->
      <div class="absolute top-0 right-0 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl -z-10 pointer-events-none"></div>

      <div class="flex flex-col md:flex-row items-start md:items-center gap-8 justify-between">
        <div class="space-y-4 max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 text-xs font-semibold">
            <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
            <span>Security Engineer</span>
          </div>

          <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
            Kenjiro Hirose
          </h1>

          <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
            東京でセキュリティエンジニアをしています。<br>
            日々の発信、撮影した写真の記録を集約した活動ログポータルサイトです。
          </p>

          <!-- SNS Links -->
          <div class="pt-2 flex flex-wrap gap-3">
            {snsLinks.map((sns) => (
              <a
                href={sns.url}
                target="_blank"
                rel="noopener noreferrer"
                class={`px-4 py-2 rounded-xl bg-slate-950 border border-slate-800 text-slate-200 text-sm font-medium transition-all duration-300 flex items-center gap-2 ${sns.color}`}
              >
                <span>{sns.icon}</span>
                <span>{sns.name}</span>
              </a>
            ))}
          </div>
        </div>

        <!-- Profile Avatar Placeholder -->
        <div class="flex-shrink-0 self-center md:self-auto">
          <div class="relative w-36 h-36 sm:w-44 sm:h-44 rounded-3xl bg-gradient-to-br from-cyan-500 via-blue-600 to-indigo-700 p-1 shadow-2xl shadow-cyan-500/20">
            <div class="w-full h-full bg-slate-950 rounded-[22px] flex flex-col items-center justify-center text-slate-100">
              <span class="text-4xl font-extrabold bg-clip-text text-transparent bg-gradient-to-r from-cyan-400 to-blue-500">
                KH
              </span>
              <span class="text-xs text-slate-500 mt-1 font-mono">@Kenjiro56</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Latest RSS Articles Pickup Section -->
    <section class="space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-2xl font-extrabold text-white flex items-center gap-2">
            <span>📝 最新の記事</span>
          </h2>
        </div>
        <a href="/articles" class="text-xs font-semibold text-cyan-400 hover:text-cyan-300 transition-colors flex items-center gap-1">
          <span>記事一覧を見る</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {latestArticles.map((article) => (
          <ArticleCard article={article} />
        ))}
      </div>
    </section>

    <!-- Latest Photos Pickup Section -->
    <section class="space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-2xl font-extrabold text-white flex items-center gap-2">
            <span>📷 最新写真ギャラリー</span>
          </h2>
        </div>
        <a href="/photos" class="text-xs font-semibold text-cyan-400 hover:text-cyan-300 transition-colors flex items-center gap-1">
          <span>写真一覧を見る</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {latestPhotos.map((photo) => (
          <PhotoCard photo={photo} />
        ))}
      </div>
    </section>

    <!-- Latest Slides Pickup Section -->
    <section class="space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-2xl font-extrabold text-white flex items-center gap-2">
            <span>🎤 スライド</span>
          </h2>
        </div>
        <a href="/slides" class="text-xs font-semibold text-cyan-400 hover:text-cyan-300 transition-colors flex items-center gap-1">
          <span>スライド一覧を見る</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {latestSlides.map((slide) => (
          <SlideCard slide={slide} />
        ))}
      </div>
    </section>
  </div>
</Layout>
