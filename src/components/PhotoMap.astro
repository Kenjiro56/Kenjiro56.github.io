---
import type { PhotoItem } from '../utils/photos';

interface Props {
  photos: PhotoItem[];
}

const { photos } = Astro.props;
---

<div class="relative w-full h-[450px] md:h-[520px] rounded-2xl overflow-hidden border border-slate-800 shadow-2xl shadow-cyan-950/20">
  <div id="leaflet-map" data-photos={JSON.stringify(photos)} class="w-full h-full z-10"></div>
  
  <div class="absolute bottom-4 left-4 z-20 bg-slate-900/90 backdrop-blur-md px-4 py-2 rounded-lg border border-slate-700/60 text-xs text-slate-300 shadow-lg flex items-center gap-2">
    <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-ping"></span>
    <span>{photos.length} 個の撮影スポットをマップに表示中</span>
  </div>
</div>

<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const mapEl = document.getElementById('leaflet-map');
    if (!mapEl || typeof L === 'undefined') return;

    const photosDataRaw = mapEl.getAttribute('data-photos');
    const photos = photosDataRaw ? JSON.parse(photosDataRaw) : [];

    const initialLat = photos.length > 0 ? photos[0].latitude : 35.6586;
    const initialLng = photos.length > 0 ? photos[0].longitude : 139.7454;
    const initialZoom = photos.length > 0 ? 3 : 2;

    const map = L.map('leaflet-map', {
      center: [initialLat, initialLng],
      zoom: initialZoom,
      zoomControl: true,
    });

    // 元の鮮やかで読みやすい CartoDB Voyager タイルレイヤーに復元
    L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
      subdomains: 'abcd',
      maxZoom: 19,
    }).addTo(map);

    const customIcon = L.divIcon({
      className: 'custom-pin',
      html: `<div class="w-7 h-7 bg-cyan-500 rounded-full border-2 border-white shadow-lg flex items-center justify-center text-white font-bold text-xs transform transition-transform hover:scale-125">📍</div>`,
      iconSize: [28, 28],
      iconAnchor: [14, 28],
      popupAnchor: [0, -28],
    });

    const bounds = L.latLngBounds();

    photos.forEach((photo) => {
      if (photo.latitude && photo.longitude) {
        bounds.extend([photo.latitude, photo.longitude]);

        const popupContent = `
          <div class="p-1 max-w-[200px]">
            <img src="${photo.url}" alt="${photo.title}" class="w-full h-24 object-cover rounded-md mb-2 border border-slate-700" />
            <h4 class="font-bold text-sm text-slate-100 leading-tight mb-1">${photo.title}</h4>
            <p class="text-xs text-cyan-400 mb-1">📍 ${photo.locationName}</p>
            <p class="text-[10px] text-slate-400">📅 ${photo.date}</p>
          </div>
        `;

        const marker = L.marker([photo.latitude, photo.longitude], { icon: customIcon })
          .addTo(map)
          .bindPopup(popupContent);

        marker.on('click', () => {
          const cardEl = document.getElementById(`photo-card-${photo.id}`);
          if (cardEl) {
            cardEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
            cardEl.classList.add('ring-2', 'ring-cyan-400');
            setTimeout(() => {
              cardEl.classList.remove('ring-2', 'ring-cyan-400');
            }, 2500);
          }
        });
      }
    });

    if (photos.length > 1) {
      map.fitBounds(bounds, { padding: [50, 50] });
    }
  });
</script>
